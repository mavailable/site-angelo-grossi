---
/**
 * Schema.org JSON-LD — Toutes les données structurées pour la homepage
 * Source : src/data/schemas.ts (doctrine C1 wf-00-cms §7)
 *
 * Ce composant est un simple injecteur : toute la logique Schema.org vit
 * dans src/data/schemas.ts (helpers centralises testables et reutilisables).
 */
import { getSiteInfo } from '@data/content';
import {
  getProfessionalServiceSchema,
  getWebsiteSchema,
  getFAQPageSchema,
  getBreadcrumbSchema,
  getSpeakableSchema,
} from '@data/schemas';

const site = getSiteInfo();

// Schemas centralises
const professionalService = getProfessionalServiceSchema();
const faqPage = getFAQPageSchema();
const webSite = getWebsiteSchema();
const breadcrumb = getBreadcrumbSchema([
  { name: 'Accueil', url: site.siteUrl },
]);
const speakable = getSpeakableSchema(
  'Angelo Grossi — Coach prise de parole en public',
  'Coach certifié RNCP 7 en prise de parole en public en Île-de-France. Approche unique mêlant coaching et improvisation théâtrale. RDV découverte gratuit.',
  site.siteUrl
);
---

<script type="application/ld+json" set:html={JSON.stringify(professionalService)} />
{faqPage && <script type="application/ld+json" set:html={JSON.stringify(faqPage)} />}
<script type="application/ld+json" set:html={JSON.stringify(webSite)} />
<script type="application/ld+json" set:html={JSON.stringify(breadcrumb)} />
<script type="application/ld+json" set:html={JSON.stringify(speakable)} />
